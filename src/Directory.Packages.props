<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="ConcurrentChunking" Version="2.0.0-prerelease.72"/>
        <PackageVersion Include="ConcurrentChunking.EntityFrameworkCore" Version="2.0.0-prerelease.72"/>
        <PackageVersion Include="JunitXml.TestLogger" Version="8.0.0"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="[8.0.0,999.999.999]"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="[8.0.0,999.999.999]"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="[8.0.0,999.999.999]"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="[8.0.0,999.999.999]"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="[8.0.0,999.999.999]"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="[8.0.3,999.999.999]"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1"/>
        <PackageVersion Include="Shouldly" Version="4.3.0"/>
        <PackageVersion Include="System.Linq.Async" Version="7.0.1"/>
        <PackageVersion Include="Testcontainers" Version="4.15.0"/>
        <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0"/>
        <PackageVersion Include="coverlet.collector" Version="10.0.1"/>
        <PackageVersion Include="xunit.analyzers" Version="2.1.0"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" privateAssets="all"/>
        <PackageVersion Include="xunit.v3" Version="4.0.1"/>
        <PackageVersion Include="xunit.v3.common" Version="4.0.1"/>
    </ItemGroup>

    <!-- C# Analyzers -->
    <ItemGroup>
        <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.290">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </GlobalPackageReference>
        <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.34.0.3385">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </GlobalPackageReference>
        <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </GlobalPackageReference>
        <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </GlobalPackageReference>
        <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </GlobalPackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(IsTestProject)' != 'true'">
        <AdditionalFiles Include="$(SolutionDir)BannedSymbols.txt"/>
        <None Include="$(SolutionDir)LICENSE.txt">
            <Pack>True</Pack>
            <PackagePath/>
        </None>
        <None Include="$(SolutionDir)icon.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="$(SolutionDir)../README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
